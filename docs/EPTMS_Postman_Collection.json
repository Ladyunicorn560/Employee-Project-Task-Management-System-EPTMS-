            "body": { "mode": "raw", "raw": "{\"firstName\": \"Jane\", \"lastName\": \"Smith\", \"email\": \"jane.smith@eptms.com\", \"password\": \"Password123!\", \"phone\": \"+1-555-0199\", \"roleId\": 3, \"departmentId\": 2, \"status\": \"Active\"}" }
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT", "url": "{{base_url}}/employees/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"firstName\": \"System\", \"lastName\": \"Administrator\", \"email\": \"admin@eptms.com\", \"phone\": \"+1-555-0100\", \"status\": \"Active\"}" }
          }
        },
        { "name": "Delete Employee", "request": { "method": "DELETE", "url": "{{base_url}}/employees/6", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }] } }
      ]
