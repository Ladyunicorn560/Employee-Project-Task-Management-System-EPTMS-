# ╔══════════════════════════════════════════════════════════════════╗
# ║   EPTMS – Environment Configuration Template                    ║
# ║   Copy this file to .env and fill in all required values.       ║
# ║   NEVER commit the .env file to version control.                ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development           # development | production | test
DOCKER_PORT=5000               # Host port when running via Docker

# ─── Database (SQL Server) ────────────────────────────────────────────────────
# For local Windows development (Windows Authentication):
DB_SERVER=Shiksha              # SQL Server instance name or hostname
DB_NAME=EPTMS_DB
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false
DB_USER=                       # Leave empty for Windows Integrated Authentication
DB_PASSWORD=                   # Leave empty for Windows Integrated Authentication

# For Docker / SQL Server with SA login:
# DB_SERVER=sqlserver          # Container service name in docker-compose
# DB_USER=sa
# DB_PASSWORD=<same as MSSQL_SA_PASSWORD>

# ─── JWT Authentication ───────────────────────────────────────────────────────
# REQUIRED: Minimum 32 characters. Use a strong random secret in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h              # Token validity: 8h | 24h | 7d

# ─── Security & CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Global rate limiter (per IP)
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100    # Max requests per window

# Auth-specific rate limiter (login endpoint only)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info                 # error | warn | info | http | debug

# ─── Docker / SQL Server (Docker Compose only) ────────────────────────────────
# Used by docker-compose.yml to configure the SQL Server container.
# NEVER use a weak password in production.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
